<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme. Compose draws the real UI; this only styles the post-splash window. -->
    <style name="Theme.BlackInk" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F9F7F7</item>
        <item name="android:windowBackground">#F9F7F7</item>
    </style>

    <!-- Launch theme applied to the activity. The AndroidX SplashScreen library styles the
         Android 12+ system splash (light background + dark diamond) to match the in-app splash
         that follows, so the two read as one continuous splash. Swaps to Theme.BlackInk after. -->
    <style name="Theme.BlackInk.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F9F7F7</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.BlackInk</item>
    </style>
</resources>
