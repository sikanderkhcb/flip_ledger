<?xml version="1.0" encoding="utf-8"?>
<!-- Intentionally "invisible" system-splash icon: a shape filled with the splash background color
     (#F9F7F7). Android 12+ always draws SOME icon on its system splash, so instead of showing the
     diamond here (which would then jump when the branded in-app splash draws it), we draw a shape
     that blends into the background. The result is a blank off-white flash, then the single branded
     splash where the diamond appears exactly once. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#F9F7F7" />
</vector>
