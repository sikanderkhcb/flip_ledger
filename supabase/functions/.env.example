# Copy to an ignored .env file and fill these values from Stripe test mode.
# Use a restricted Stripe key (rk_...) with only the permissions this integration needs.
STRIPE_API_KEY=
STRIPE_SOLO_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_WEBHOOK_SECRET=

# Transactional email (Resend) — used by stripe-webhook to send the subscription confirmation.
# Get an API key at resend.com and verify a sending domain. EMAIL_FROM must use that domain.
RESEND_API_KEY=
EMAIL_FROM=BlackInk <noreply@yourdomain.com>

# Shared secret guarding send-welcome-email. Set the SAME value as the auth.users INSERT
# Database Webhook's `x-webhook-secret` header. Generate one with: openssl rand -hex 32
WELCOME_HOOK_SECRET=
